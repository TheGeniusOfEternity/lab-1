{
  "scripts": {
    "lint": "eslint 'src/**/*.{js,ts}'",
    "prettier": "prettier --write 'src/**/*.{js,ts,json,css,md}'",
    "webpack": "webpack --config webpack.config.js",
    "build": "npm run lint && npm run prettier && npm run webpack",
    "start": "webpack serve",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --fix",
    "*.{js,json,css,scss,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "html-webpack-plugin": "^5.6.4",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "sass": "^1.93.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "axios": "^1.12.2"
  }
